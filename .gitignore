# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Patterns are intentionally NOT anchored to the repo root (no leading `/`)
# so they apply to every package — e.g. `web/`, future `mobile/`, etc.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production builds (generic)
build

# native build outputs (Capacitor / iOS / Android — added now so a future
# mobile/ package doesn't accidentally commit ios/build/ or android/.gradle/)
ios/build/
ios/Pods/
ios/DerivedData/
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab
*.ipa

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
